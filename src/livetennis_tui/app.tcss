/* Dark court, tennis-ball accent. */

Screen {
    background: #101418;
    color: #d8dee4;
}

Header {
    background: #16351d;
    color: #eaf5d8;
    text-style: bold;
}

Footer {
    background: #0c0f12;
}

#main {
    padding: 0 1;
}

DataTable {
    background: #101418;
    height: 1fr;
}

DataTable > .datatable--header {
    background: #16351d;
    color: #c8f04b;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: #24421f;
    color: #f2ffdc;
}

DataTable > .datatable--hover {
    background: #1a2620;
}

#empty-state {
    display: none;
    padding: 2 4;
    margin: 2 4;
    border: round #2c4a24;
    color: #aab6a0;
    content-align: center middle;
    text-align: center;
}

#status-bar {
    dock: bottom;
    height: 1;
    padding: 0 1;
    background: #0c0f12;
    color: #8fa08a;
    offset-y: -1;
}

/* --- modals --------------------------------------------------------------- */

PlayerSearch, PlayerProfile, NoKeyScreen {
    align: center middle;
    background: rgba(6, 8, 10, 0.6);
}

#search-box {
    width: 84;
    max-width: 95%;
    height: 26;
    padding: 1 2;
    background: #131a16;
    border: round #c8f04b;
}

#search-title, #profile-name {
    color: #c8f04b;
    text-style: bold;
    padding-bottom: 1;
}

#search-input {
    margin-bottom: 1;
}

#search-results {
    height: 1fr;
}

#search-status {
    height: 2;
    color: #8fa08a;
    padding-top: 1;
}

#profile-box {
    width: 56;
    max-width: 90%;
    height: auto;
    padding: 1 3;
    background: #131a16;
    border: round #c8f04b;
}

#profile-body {
    padding: 1 0;
}

.modal-hint {
    color: #5d6b5a;
    padding-top: 1;
}

#nokey-box {
    width: 78;
    max-width: 95%;
    height: auto;
    padding: 1 3;
    background: #131a16;
    border: round #c8f04b;
}
